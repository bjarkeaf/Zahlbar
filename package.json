{
  "name": "earmark",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Obsidian plugin that draws a Markdown plan of income and outgoings as two stacked bars",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/obsidian/main.ts --bundle --outfile=main.js --format=cjs --platform=browser --target=es2022 --external:obsidian --external:electron --external:@codemirror/* --external:@lezer/*",
    "dev": "npm run build -- --sourcemap=inline --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "harness": "node harness/build.mjs && node harness/run.mjs",
    "install:vault": "node scripts/install-vault.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "obsidian": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
